<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet">
    <title>Netball Tracker</title>
</head>
<body class="bg-light">
    <%- include('partials/navbar') %>

    <div class="container mt-4" style="max-width: 500px;">
        <div class="d-flex justify-content-between align-items-center mb-3">
            <h2>Netball Tracker</h2>
            <a href="/add" class="btn btn-dark btn-sm">+ Log New Session</a>
        </div>

        <h5>PAST SESSIONS:</h5>
        <hr>

        <% sessions.forEach(function(session) { %>
            <div class="card bg-dark text-white mb-2 shadow-sm">
                <div class="card-body">
                    <h6>★ Position: <%= session.position %></h6>
                    <p class="m-0">Shooting: <%= session.goals %> / <%= session.total %></p>
                    
                    <% if(session.feedback) { %>
                        <small class="text-info">Notes: <%= session.feedback %></small>
                    <% } %>
                </div>
            </div>
        <% }); %>
    </div>
</body>
</html>